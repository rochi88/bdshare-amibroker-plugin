// ============================================================================
// BDShare_DSE_Dashboard.afl
// Sample AFL formula demonstrating how to use BDShare DSE plugin data.
// Written for an end-of-day database.
//
// Prerequisites:
//   1. BDShare_DSE.dll installed in AmiBroker\Plugins\
//   2. Symbol's "Name" field set to DSE code (e.g. GP, ACI, BEXIMCO)
//   3. AmiBroker data source set to "BDShare DSE Data Feed"
// ============================================================================

_SECTION_BEGIN("BDShare DSE Dashboard");

// -- Price and volume (supplied via GetQuotesEx) ------------------------------
SetChartOptions( 0, chartShowDates );
Plot( C, "Close", IIf( C >= Ref( C, -1 ), colorGreen, colorRed ), styleCandle );
Plot( V, "Volume", colorBlue, styleHistogram | styleOwnScale | styleNoLabel, 0, 4 * HHV( V, 100 ) );

// -- Moving averages ----------------------------------------------------------
Plot( MA( C, 20 ),  "MA(20)",  colorYellow, styleLine );
Plot( MA( C, 50 ),  "MA(50)",  colorOrange, styleLine );
Plot( EMA( C, 10 ), "EMA(10)", colorViolet, styleLine );

// -- Daily extras: in an EOD database Aux1 is traded value (mn), Aux2 is trades -
TradedValue = Aux1;
TradeCount  = Aux2;

// -- Market depth: best bid/ask for the current symbol ------------------------
// Each is Null when that side of the book has no orders. Fetched from DSE at
// most every 30 seconds per symbol.
BidPrice = LastValue( GetExtraData( "BidPrice" ) );
BidVol   = LastValue( GetExtraData( "BidVol" ) );
AskPrice = LastValue( GetExtraData( "AskPrice" ) );
AskVol   = LastValue( GetExtraData( "AskVol" ) );

Plot( BidPrice, "Bid", colorAqua,   styleLine | styleDashed | styleNoRescale );
Plot( AskPrice, "Ask", colorOrange, styleLine | styleDashed | styleNoRescale );

// -- Session and news ---------------------------------------------------------
MarketOpen = GetExtraData( "MarketOpen" );
NewsCount  = GetExtraData( "NewsCount" );
Headline   = GetExtraData( "NewsHeadline" );

Title = StrFormat(
    "{{NAME}} - {{DATE}}  O %.2f  H %.2f  L %.2f  C %.2f  V %.0f  Value %.2f mn  Trades %.0f\n"
    + "Bid %.2f (%.0f)  Ask %.2f (%.0f)  News items %.0f\n",
    O, H, L, C, V, TradedValue, TradeCount,
    BidPrice, BidVol, AskPrice, AskVol, NewsCount )
    + WriteIf( MarketOpen, "Market open", "Market closed" )
    + WriteIf( Headline != "", "  |  " + Headline, "" );

// -- RSI, drawn on its own 0-100 scale over the price pane --------------------
RsiValue = RSI( 14 );
Plot( RsiValue, "RSI(14)", colorWhite, styleLine | styleOwnScale | styleNoLabel, 0, 100 );
Plot( 70, "", colorRed,   styleLine | styleOwnScale | styleNoLabel, 0, 100 );
Plot( 30, "", colorGreen, styleLine | styleOwnScale | styleNoLabel, 0, 100 );

_SECTION_END();
